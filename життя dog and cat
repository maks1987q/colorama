import random


class Cat:

  def __init__(self, name):
    self.name = name
    self.satiety = 50  # Ситість (0-100)
    self.energy = 50  # Енергія (0-100)
    self.alive = True

  def eat(self):
    print(f"{self.name} їсть...")
    self.satiety += 20
    self.energy += 5

  def sleep(self):
    print(f"{self.name} спить...")
    self.energy += 30
    self.satiety -= 10

  def play(self):
    print(f"{self.name} грається...")
    self.satiety -= 15
    self.energy -= 20

  def live_a_day(self, day):
    print(f"--- День {day} для {self.name} ---")

    # Перевірка стану
    if self.satiety <= 0:
      print(f"{self.name} занадто голодний...")
      self.alive = False
      return

    # Логіка вибору дій
    if self.satiety < 20:
      self.eat()
    elif self.energy < 20:
      self.sleep()
    else:
      action = random.choice([1, 2, 3])
      if action == 1:
        self.eat()
      elif action == 2:
        self.sleep()
      else:
        self.play()

    print(f"Стан: Ситість = {self.satiety}, Енергія = {self.energy}\n")


# Симуляція 7 днів життя
cat = Cat("Мурчик")
for day in range(1, 8):
  if not cat.alive:
    break
  cat.live_a_day(day)
